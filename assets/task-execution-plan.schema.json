{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agency/task-execution-plan.schema.json",
  "title": "Agency Task Execution Plan",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "title",
    "objective",
    "source_discussion",
    "acceptance_criteria",
    "out_of_scope",
    "execution_model_request",
    "work_items",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "source_discussion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "accepted_decisions", "constraints", "assumptions", "open_questions"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "accepted_decisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "execution_model_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_request", "reasoning_request", "resolved_model_id", "resolution_status"],
      "properties": {
        "display_request": {"const": "GPT-5.6 Sol"},
        "reasoning_request": {"const": "ultra"},
        "resolved_model_id": {"type": ["string", "null"]},
        "resolution_status": {
          "enum": ["pending", "resolved", "user_choice_required", "unavailable", "readback_mismatch"]
        }
      }
    },
    "work_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/work_item"}
    },
    "status": {
      "enum": [
        "discussion",
        "plan_ready",
        "execution_ready",
        "executing",
        "verifying",
        "completed",
        "archived",
        "cancelled",
        "superseded",
        "blocked"
      ]
    },
    "status_reason": {"type": "string"}
  },
  "$defs": {
    "work_item": {
      "type": "object",
      "required": [
        "work_id",
        "title",
        "outcome",
        "work_type",
        "dependencies",
        "read_scope",
        "write_scope",
        "verification",
        "risk",
        "uncertainty",
        "context_coupling",
        "parallelizable",
        "isolated_worktree_required",
        "accountable_position",
        "profile",
        "review_profile",
        "status",
        "evidence_refs",
        "blockers"
      ],
      "properties": {
        "work_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"},
        "title": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "work_type": {
          "enum": ["research", "architecture", "implementation", "writing", "testing", "review", "integration", "release"]
        },
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "read_scope": {"type": "array", "items": {"type": "string"}},
        "write_scope": {"type": "array", "items": {"type": "string"}},
        "verification": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "risk": {"enum": ["low", "medium", "high", "critical"]},
        "uncertainty": {"enum": ["low", "medium", "high"]},
        "context_coupling": {"enum": ["low", "medium", "high"]},
        "parallelizable": {"type": "boolean"},
        "isolated_worktree_required": {"type": "boolean"},
        "accountable_position": {"type": ["string", "null"]},
        "profile": {"type": ["string", "null"]},
        "review_profile": {"type": ["string", "null"]},
        "status": {"enum": ["pending", "in_progress", "completed", "blocked", "waived"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "required": {"type": "boolean", "default": true}
      }
    }
  }
}
