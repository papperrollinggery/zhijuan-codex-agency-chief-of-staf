{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agency/task-execution-plan.schema.json",
  "title": "Agency Task Execution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "objective",
    "source_discussion",
    "acceptance_criteria",
    "work_items"
  ],
  "properties": {
    "schema_version": {"const": "1.0", "default": "1.0"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "source_discussion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "accepted_decisions": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
        "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
        "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []}
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
    "execution_model_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_request", "reasoning_request", "resolved_model_id", "resolution_status"],
      "properties": {
        "display_request": {"const": "GPT-5.6 Sol"},
        "reasoning_request": {"const": "ultra"},
        "resolved_model_id": {"type": ["string", "null"]},
        "resolution_status": {
          "enum": ["pending", "resolved", "user_choice_required", "unavailable", "readback_mismatch"]
        }
      }
    },
    "work_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/work_item"}
    },
    "status": {
      "enum": [
        "discussion",
        "plan_ready",
        "execution_ready",
        "executing",
        "verifying",
        "completed",
        "archived",
        "cancelled",
        "superseded",
        "blocked"
      ],
      "default": "plan_ready"
    },
    "status_reason": {"type": "string"},
    "acceptance_evidence": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "title",
        "outcome",
        "work_type"
      ],
      "properties": {
        "work_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"},
        "title": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "work_type": {
          "enum": ["research", "architecture", "implementation", "writing", "testing", "review", "integration", "release"]
        },
        "dependencies": {"type": "array", "items": {"type": "string"}, "default": []},
        "read_scope": {"type": "array", "items": {"type": "string"}, "default": []},
        "write_scope": {"type": "array", "items": {"type": "string"}, "default": []},
        "verification": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
        "risk": {"enum": ["low", "medium", "high", "critical"], "default": "medium"},
        "uncertainty": {"enum": ["low", "medium", "high"], "default": "medium"},
        "context_coupling": {"enum": ["low", "medium", "high"], "default": "high"},
        "parallelizable": {"type": "boolean", "default": false},
        "isolated_worktree_required": {"type": "boolean", "default": false},
        "accountable_position": {"type": ["string", "null"], "default": ""},
        "profile": {"type": ["string", "null"], "default": null},
        "review_profile": {"type": ["string", "null"], "default": null},
        "status": {"enum": ["pending", "in_progress", "completed", "blocked", "waived"], "default": "pending"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "default": []},
        "blockers": {"type": "array", "items": {"type": "string"}, "default": []},
        "required": {"type": "boolean", "default": true},
        "waiver_reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
