{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agency/knowledge-deposit.schema.json",
  "title": "Agency Knowledge Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["knowledge_id", "category", "statement", "applicability", "evidence_refs", "source_task_id", "confidence", "sensitivity", "recommended_target", "status"],
  "properties": {
    "knowledge_id": {"type": "string", "minLength": 1},
    "category": {"enum": ["architecture", "workflow", "runbook", "debugging", "testing", "decision", "preference"]},
    "statement": {"type": "string", "minLength": 1},
    "applicability": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_task_id": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["verified", "limited"]},
    "sensitivity": {"enum": ["public", "internal", "restricted"]},
    "recommended_target": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "deposited", "rejected"]}
  }
}
