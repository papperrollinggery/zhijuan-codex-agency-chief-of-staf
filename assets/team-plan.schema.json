{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agency/team-plan.schema.json",
  "title": "Agency Team Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "status", "team_tier", "score", "score_breakdown", "positions", "waves", "limits"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string"},
    "status": {"enum": ["pending", "ready"]},
    "team_tier": {"type": ["string", "null"], "enum": [null, "solo", "lean_team", "project_team", "program_team"]},
    "score": {"type": ["integer", "null"], "minimum": 0},
    "score_breakdown": {"type": "object"},
    "positions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["position_id", "title", "profile", "work_items", "instance", "read_scope", "write_scope", "wave"],
        "properties": {
          "position_id": {"type": "string"},
          "title": {"type": "string"},
          "profile": {"type": "string"},
          "work_items": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "instance": {"type": "integer", "minimum": 1},
          "read_scope": {"type": "array", "items": {"type": "string"}},
          "write_scope": {"type": "array", "items": {"type": "string"}},
          "wave": {"type": "integer", "minimum": 0},
          "isolated_worktree_required": {"type": "boolean"}
        }
      }
    },
    "waves": {"type": "array", "items": {"type": "object"}},
    "write_conflicts": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "string"}
      }
    },
    "root_owned_work_items": {"type": "array", "items": {"type": "string"}},
    "limits": {
      "type": "object",
      "required": ["max_active_positions", "max_parallel_positions", "max_parallel_writers", "default_cold_reviewers", "max_review_fix_rounds"],
      "properties": {
        "max_active_positions": {"const": 5},
        "max_parallel_positions": {"const": 3},
        "max_parallel_writers": {"const": 2},
        "default_cold_reviewers": {"const": 1},
        "max_review_fix_rounds": {"const": 2}
      }
    }
  }
}
